#!/bin/sh
# KontainerOS - konfigurasi live-build (Debian 12 "bookworm", amd64)
# Dipanggil otomatis oleh `lb config`. Ubah opsi di sini, bukan di config/ hasil generate.

set -e

lb config noauto \
	--distribution bookworm \
	--architectures amd64 \
	--linux-flavours amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--mirror-bootstrap "http://deb.debian.org/debian/" \
	--mirror-chroot "http://deb.debian.org/debian/" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--security true \
	--updates true \
	--apt-recommends false \
	--binary-images iso-hybrid \
	--bootloaders "syslinux,grub-efi" \
	--debian-installer live \
	--debian-installer-distribution bookworm \
	--debian-installer-gui true \
	--memtest none \
	--image-name kontaineros \
	--iso-application "KontainerOS" \
	--iso-publisher "Kelompok 5 Proyek SO - Distro Pengembang Container" \
	--iso-volume "KONTAINEROS" \
	--bootappend-live "boot=live components quiet splash username=dev user-fullname=Developer hostname=kontaineros locales=id_ID.UTF-8 timezone=Asia/Makassar keyboard-layouts=us" \
	"${@}"
